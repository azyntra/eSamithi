{
  "expo": {
    "name": "eSamithi",
    "slug": "esamithi-member",
    "version": "1.7.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/741f24ff-0b1b-4b30-8034-08f7a6f8d7eb"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "esamithi",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiEnv": "prod",
      "apiUrls": {
        "prod": "https://api.esamithi.com/api/v1",
        "testbed": "http://212.227.103.150/api/v1"
      },
      "samithis": {
        "prod": "samithi01",
        "testbed": "test01"
      },
      "directoryUrl": "https://api.esamithi.com/directory",
      "router": {},
      "eas": {
        "projectId": "741f24ff-0b1b-4b30-8034-08f7a6f8d7eb"
      }
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "lk.esamithi.member",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "lk.esamithi.member",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1E64D4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1752B4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#174A9F"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E64D4"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "eSamithi uses the camera to scan membership QR codes when marking attendance, and to photograph the pages of the meeting minutes when the Secretary prepares them. Page photos are shared only with the members of your society.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/withPortraitNotRequired",
      [
        "expo-audio",
        {
          "microphonePermission": "eSamithi uses the microphone only when the Secretary records the meeting minutes being read. The recording is shared only with the members of your society.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "azyntra-technologies"
  }
}
