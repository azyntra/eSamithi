# eSamithi API Server — Environment Variables
# Copy this file to .env and fill in your values

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=esamithi_user
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=esamithi

# JWT Authentication
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARACTER_STRING
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=production

# Web staff sessions (app.esamithi.com) — see docs/ESAMITHI-WEB-APP-REQUIREMENTS.md §6.5
STAFF_ACCESS_TTL=15m            # access token lifetime
STAFF_REFRESH_HOURS=12          # idle limit: each refresh extends the session by this much
STAFF_SESSION_MAX_HOURS=24      # absolute limit per sign-in
STAFF_LOCKOUT_MAX_FAILS=10      # consecutive failures before a lockout
STAFF_LOCKOUT_MINUTES=15
STAFF_LOCKOUT_SCOPE=web         # web (default) | all (desktop too, after cut-over) | off
STAFF_LOGIN_LIMIT=30            # failed sign-ins per IP+samithi per 15 min
PASSWORD_REHASH=off             # on = upgrade legacy SHA-256 hashes to bcrypt on login (Deploy B)
CORS_ALLOWED_ORIGINS=           # empty = allow all (today); e.g. https://app.esamithi.com,https://console.esamithi.com
